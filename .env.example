# Paste these into Dokploy's Environment tab for the application.
# Dokploy stores them encrypted and injects them at deploy time — do not
# commit a filled-in copy of this file.

# --- Required ---
SITE_URL=https://indiamovieguide.com
TMDB_API_KEY=
ADMIN_PASSWORD=

# --- Optional providers (features degrade quietly if unset) ---
TMDB_BEARER_TOKEN=
YOUTUBE_API_KEY=
OMDB_API_KEY=
MOTN_API_KEY=

# Serve auth cookies over HTTPS only. Keep 1 in production.
COOKIE_SECURE=1

# --- Litestream backup target (S3-compatible: Backblaze B2, Cloudflare R2, ...) ---
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
