# Paste into Dokploy's Environment tab. Compose passes this file through
# wholesale, so ANY variable the app reads can be set here -- this file is a
# reference for the common ones, not an exhaustive contract.
#
# Everything left unset stays genuinely unset and falls back to its code
# default, which is what most of the tuning knobs below want.
#
# NODE_ENV, PORT and DB_PATH are pinned in docker-compose.yml and override
# anything set here. Don't copy DB_PATH over from Render -- it points at
# /var/data/indiamovieguide-v2.sqlite, which doesn't exist on this host.
#
# Set on Render but read by no code, so deliberately omitted:
# OPENAI_API_KEY, OTT_API_KEY, WEB_CONCURRENCY.

# --- Required ---
SITE_URL=https://indiamovieguide.com
TMDB_API_KEY=
ADMIN_PASSWORD=

# --- Build-time (Vite inlines these into the JS bundle) ---
# Changing either requires a rebuild, not just a restart. Both are public
# values, exposed in the bundle by design.
VITE_GA_MEASUREMENT_ID=
VITE_RECAPTCHA_SITEKEY=

# --- Auth / captcha ---
# RECAPTCHA_SECRET pairs with VITE_RECAPTCHA_SITEKEY above; without both,
# signup and login render "Captcha not configured".
RECAPTCHA_SECRET=
# Set to 1 only in local dev to skip captcha entirely. Never in production.
CAPTCHA_BYPASS=
COOKIE_SECURE=1

# --- Movie of the Night (OTT deeplinks) ---
MOTN_API_KEY=
MOTN_COUNTRY=
MOTN_DAILY_BUDGET=
MOTN_ATTEMPT_MINUTES=
MOTN_PAUSE_MINUTES=
MOTN_DEEPLINK_TTL_HOURS=

# --- YouTube song lookups ---
YOUTUBE_API_KEY=
YOUTUBE_PER_TRACK_LOOKUPS=
YOUTUBE_QUOTA_BACKOFF_MINUTES=
YOUTUBE_SONG_QUERY_LIMIT=

# --- Caching / sitemap / seeding ---
HTML_CACHE_TTL_MINUTES=
SITEMAP_MAX_URLS=
SEED_TITLES=
DEBUG_SONGS=

# --- Optional providers (not currently set on Render) ---
TMDB_BEARER_TOKEN=
OMDB_API_KEY=

# --- Litestream backups (optional; also set COMPOSE_PROFILES=backup) ---
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Tuning knobs: all optional, all have code defaults ---
# Uncomment only what you need to override.
#
# Home page seeding:
# HOME_SEED_ALL_LANGUAGES=   HOME_SEED_CONCURRENCY=   HOME_SEED_MAX_IDS=
# HOME_SEED_PAGES=
#
# Per-language seeding:
# LANG_SEED_DESIRED_TOTAL=   LANG_SEED_DESIRED_UPCOMING=
# LANG_SEED_DISCOVER_BUDGET= LANG_SEED_FORWARD_DAYS=  LANG_SEED_LOOKBACK_DAYS=
# LANG_SEED_MAX_IDS=         LANG_SEED_PAGES=         LANG_SEED_STRATEGY=
# LANG_SEED_WINDOW_DAYS=
#
# Refresh intervals:
# DETAILS_REFRESH_HOURS=     UPCOMING_DETAILS_REFRESH_HOURS=
# OTT_REFRESH_HOURS=         OTT_REGION=
# SONGS_AUTO_REFRESH_HOURS=  SONGS_AUTO_ATTEMPT_MINUTES=
#
# Sitemap:
# SITEMAP_GENRE_LIMIT=       SITEMAP_LANG_LIMIT=
#
# Other:
# HCAPTCHA_SECRET=           MOTN_RAPIDAPI_HOST=      RESET_RETURN_TOKEN=
# HOST=  (compose sets NODE_ENV=production, so this defaults to 0.0.0.0)
#
# Ingest agent (npm run agent:ingest, not the web process):
# AGENT_DAYS_FUTURE=  AGENT_DAYS_PAST=  AGENT_ENRICH=  AGENT_LANGS=  AGENT_LIMIT=
